# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Generate a key with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=paste-a-long-random-key-here
# True only on your own computer. Leave out (or False) anywhere else: it shows detailed error pages.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to True when the site is served over HTTPS
SECURE_COOKIES=False

# Local PostgreSQL:
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/dila_dila
# Supabase: use the *Session pooler* connection string and set DB_SSL_REQUIRE=True
# DATABASE_URL=postgresql://postgres.xxxx:yourpassword@aws-0-xx.pooler.supabase.com:5432/postgres
DB_SSL_REQUIRE=False

# Optional: a second, local database for running tests
# USE_LOCAL_TEST_DB=True
# LOCAL_TEST_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/dila_dila_test

# Optional: real email for password reset (otherwise the link is printed in the terminal)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
